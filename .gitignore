# ---------------------------------------------------------------
# Unity generated folders — rebuilt automatically, never commit.
# ---------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ignore .meta files for assets that ARE tracked.
!/[Aa]ssets/**/*.meta

# ---------------------------------------------------------------
# IDE / solution files — regenerated by Unity on demand.
# ---------------------------------------------------------------
.vs/
.vscode/
.idea/
.gradle/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
[Aa]ssets/Plugins/Editor/JetBrains*

# ---------------------------------------------------------------
# Build output
# ---------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Auto-generated Android streaming assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
